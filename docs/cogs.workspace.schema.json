{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/irgipaulius/cogs/main/docs/cogs.workspace.schema.json",
  "title": "CoGS workspace",
  "type": "object",
  "required": ["name", "apps"],
  "properties": {
    "name": { "type": "string" },
    "deploy": {
      "type": "object",
      "properties": {
        "bind_host": { "type": "string" },
        "base_port": { "type": "integer" },
        "port_step": { "type": "integer" },
        "reserved_ports": { "type": "array", "items": { "type": "integer" } }
      }
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
