COGS_LISTEN=127.0.0.1:8080
COGS_DB_PATH=data/data.db
COGS_SESSION_SECRET=change-me-to-a-long-random-string

# Turnstile (public API)
COGS_TURNSTILE_SECRET=
COGS_TURNSTILE_SITE_KEY=

# Cloudflare Access (admin routes)
COGS_ACCESS_TEAM_DOMAIN=
COGS_ACCESS_AUDIENCE=

# Private Worker -> origin (no public hostname)
COGS_PRIVATE_TOKEN=

# Optional API key for automation
COGS_API_KEY=

# R2 (S3 API)
COGS_R2_ACCOUNT_ID=
COGS_R2_ACCESS_KEY_ID=
COGS_R2_SECRET_ACCESS_KEY=
COGS_R2_BUCKET=

# D1 sync target
COGS_D1_ACCOUNT_ID=
COGS_D1_DATABASE_ID=
COGS_D1_API_TOKEN=

# Jobs: os (default) or internal
COGS_JOBS_MODE=os
