COGS_LISTEN=127.0.0.1:18786
COGS_ALLOW_PUBLIC_BIND=1
COGS_ADMIN_DB_PATH=data/admin.db
COGS_WORKSPACE_ROOT=/path/to/cogs
# GitHub OAuth App client id (public) — required for dashboard Sign in with GitHub / Add app
COGS_GITHUB_CLIENT_ID=
COGS_PUBLIC_PAGE_ORIGIN=https://cogs-admin.example.com
COGS_PUBLIC_API_URL=https://cogs-admin.example.com
# Dev only if unix peer check blocks go run:
# COGS_ADMIN_DEV=1
