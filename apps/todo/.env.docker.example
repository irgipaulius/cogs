# Optional overrides for docker compose (copy to .env.docker).
COGS_SESSION_SECRET=change-me
COGS_PUBLIC_PAGE_ORIGIN=https://todo.example.com
COGS_PUBLIC_API_URL=https://todo-api.example.com
# Large upload test (99MB+); tunnel may still cap ~100MB — use http://127.0.0.1:18787 for local tests
COGS_MAX_UPLOAD_BYTES=104857600
MINIO_ROOT_USER=cogsminio
MINIO_ROOT_PASSWORD=cogsminio-dev-change-me
MINIO_BUCKET=cogs-todo-blobs
